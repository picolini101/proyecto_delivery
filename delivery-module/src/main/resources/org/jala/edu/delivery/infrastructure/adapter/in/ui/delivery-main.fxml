<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Main view of the delivery module, opened by the "Deliveries" navigation button -->
<VBox styleClass="page"
      spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.DeliveryMainController">

    <Label styleClass="page-title" text="Deliveries"/>
    <Label styleClass="subtitle" wrapText="true"
           text="Follow each delivery from pickup to drop-off and the courier assigned to it."/>

    <HBox styleClass="module-actions">
        <Button fx:id="readyOrdersButton" styleClass="module-action" text="Ready orders"
                onAction="#onReadyOrders"/>
        <Button fx:id="deliveryHistoryButton" styleClass="module-action" text="Delivery history"
                onAction="#onDeliveryHistory"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <fx:include source="courier-registration.fxml"/>
        </content>
    </ScrollPane>

</VBox>
