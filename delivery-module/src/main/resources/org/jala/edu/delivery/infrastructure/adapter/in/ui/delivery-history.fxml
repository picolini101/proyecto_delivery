<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.DeliveryHistoryController">

    <Label styleClass="page-title" text="Delivery history"/>

    <HBox fx:id="searchBar" styleClass="toolbar">
        <Label text="Courier id"/>
        <TextField fx:id="courierIdField" prefColumnCount="30"/>
        <Button fx:id="consultButton" styleClass="primary" text="Consult" defaultButton="true" onAction="#onConsult"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="message"/>
    </HBox>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No deliveries to show."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="orderColumn" text="Order" prefWidth="110"/>
            <TableColumn fx:id="localityColumn" text="Locality" prefWidth="220"/>
            <TableColumn fx:id="deliveredOnColumn" text="Delivered on" prefWidth="140"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="110"/>
        </columns>
    </TableView>

    <Label fx:id="totalLabel" styleClass="read-only"/>
</VBox>
