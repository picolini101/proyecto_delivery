<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.CourierRegistrationController">

    <Label styleClass="page-title" text="Registro de repartidores"/>

    <Label styleClass="subtitle"
           wrapText="true"
           text="Completa los datos para registrar un repartidor, los campos se validan mientras escribes"/>

    <VBox spacing="6" maxWidth="560">

        <Label text="Nombre completo"/>

        <TextField fx:id="nameField"
                   promptText="Ej. Juan Pérez"/>

        <Label fx:id="nameErrorLabel"
               styleClass="message error"
               visible="false"
               managed="false"
               wrapText="true"/>

        <Label text="Teléfono"/>

        <TextField fx:id="phoneField"
                   promptText="Ej. 3001234567"/>

        <Label fx:id="phoneErrorLabel"
               styleClass="message error"
               visible="false"
               managed="false"
               wrapText="true"/>

        <Label text="Medio de transporte"/>

        <ComboBox fx:id="transportModeComboBox"
                  maxWidth="Infinity"
                  promptText="Selecciona una opción"/>

        <Label fx:id="transportErrorLabel"
               styleClass="message error"
               visible="false"
               managed="false"
               wrapText="true"/>

        <HBox alignment="CENTER_LEFT" spacing="12">

            <Button fx:id="registerButton"
                    styleClass="primary"
                    text="Registrar Repartidor"
                    onAction="#onRegister"/>

            <ProgressIndicator fx:id="spinner"
                               prefWidth="22"
                               prefHeight="22"
                               maxWidth="22"
                               maxHeight="22"
                               visible="false"
                               managed="false"/>

        </HBox>

        <Label fx:id="statusLabel"
               styleClass="message info"
               wrapText="true"/>

    </VBox>

    <Label styleClass="page-title"
           text="Repartidores registrados"/>

    <TableView fx:id="couriersTable"
               VBox.vgrow="ALWAYS"
               prefHeight="260">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Nombre"
                         prefWidth="220"/>

            <TableColumn fx:id="phoneColumn"
                         text="Teléfono"
                         prefWidth="150"/>

            <TableColumn fx:id="transportColumn"
                         text="Transporte"
                         prefWidth="150"/>

            <TableColumn fx:id="roleColumn"
                         text="Rol"
                         prefWidth="100"/>

        </columns>

        <placeholder>
            <Label text="Todavía no hay repartidores registrados"/>
        </placeholder>

    </TableView>

</VBox>