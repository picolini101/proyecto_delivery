<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.CustomerShipmentController">

    <Label styleClass="page-title" text="Mi envío"/>
    <Label fx:id="messageLabel" styleClass="message"/>
    <Label fx:id="emptyLabel" text="No hay un envío en curso" visible="false" managed="false"/>

    <VBox fx:id="progressPanel" spacing="12" visible="false" managed="false">
        <Label fx:id="progressLabel" styleClass="subtitle"/>
        <Label fx:id="codeLabel" text="Código de confirmación"/>
    </VBox>

    <Button fx:id="refreshButton" text="Actualizar" onAction="#onRefresh"/>
</VBox>
