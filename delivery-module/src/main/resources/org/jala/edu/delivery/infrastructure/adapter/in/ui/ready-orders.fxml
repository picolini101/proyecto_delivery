<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.ReadyOrdersController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="Pedidos listos para entrega"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="message"/>
        <Button fx:id="takeButton" styleClass="primary" text="Tomar Pedido" onAction="#onTake"/>
        <Button fx:id="refreshButton" text="Actualizar" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No hay pedidos disponibles en este momento"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="orderIdColumn" text="ID" prefWidth="280"/>
            <TableColumn fx:id="addressColumn" text="Dirección" prefWidth="240"/>
            <TableColumn fx:id="shippingCostColumn" text="Costo de envío" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
