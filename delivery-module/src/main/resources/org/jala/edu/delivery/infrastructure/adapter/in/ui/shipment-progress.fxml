<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.delivery.infrastructure.adapter.in.ui.ShipmentProgressController">

    <Label styleClass="page-title" text="Envío en curso"/>
    <Label fx:id="messageLabel" styleClass="message"/>
    <Label fx:id="emptyLabel" text="No hay un envío en curso" visible="false" managed="false"/>

    <VBox fx:id="progressPanel" spacing="12" visible="false" managed="false">
        <Label fx:id="progressLabel" styleClass="subtitle"/>
        <Label text="En camino"/>
        <Label text="Retirado"/>
        <Label text="Entregado"/>
        <HBox spacing="8">
            <Button fx:id="pickUpButton" text="Retirado" onAction="#onPickUp"/>
            <TextField fx:id="codeField" promptText="Código de confirmación"/>
            <Button fx:id="deliverButton" styleClass="primary" text="Entregado" onAction="#onDeliver"/>
        </HBox>
        <HBox spacing="8">
            <Button fx:id="cancelButton" text="Cancelar" onAction="#onCancel"/>
            <Button fx:id="delegateButton" text="Delegar" onAction="#onDelegate"/>
        </HBox>
    </VBox>
</VBox>
