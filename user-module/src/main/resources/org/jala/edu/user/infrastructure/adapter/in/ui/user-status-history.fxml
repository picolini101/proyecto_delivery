<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" prefWidth="620" prefHeight="380"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.user.infrastructure.adapter.in.ui.UserStatusHistoryController">

    <Label styleClass="page-title" text="Status history"/>
    <Label fx:id="userLabel" styleClass="read-only"/>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No status changes"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="140"/>
            <TableColumn fx:id="fromColumn" text="From" prefWidth="90"/>
            <TableColumn fx:id="toColumn" text="To" prefWidth="90"/>
            <TableColumn fx:id="changedByColumn" text="Changed by" prefWidth="180"/>
        </columns>
    </TableView>

    <Label fx:id="messageLabel" styleClass="message, error" wrapText="true"/>

    <HBox styleClass="actions">
        <Button text="Close" cancelButton="true" defaultButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
