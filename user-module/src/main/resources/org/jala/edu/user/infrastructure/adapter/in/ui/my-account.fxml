<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jala.edu.user.infrastructure.adapter.in.ui.MyAccountController">
    <VBox styleClass="page" maxWidth="560">

        <Label styleClass="page-title" text="My account"/>

        <!-- Email and role identify the account: only an administrator changes them (RF-1.08). -->
        <GridPane styleClass="form">
            <columnConstraints>
                <ColumnConstraints minWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Email" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="emailLabel" styleClass="read-only" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Role" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="roleLabel" styleClass="read-only" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Status" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="statusLabel" styleClass="read-only" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <Label styleClass="subtitle" text="Profile"/>

        <GridPane fx:id="profileForm" styleClass="form">
            <columnConstraints>
                <ColumnConstraints minWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="First name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Last name *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Phone" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" promptText="Optional, e.g. +59170000000" GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

            <Button fx:id="saveProfileButton" styleClass="primary" text="Save profile"
                    onAction="#onSaveProfile" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Label fx:id="profileMessageLabel" styleClass="message" wrapText="true"/>

        <Label styleClass="subtitle" text="Change password"/>

        <GridPane fx:id="passwordForm" styleClass="form">
            <columnConstraints>
                <ColumnConstraints minWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Current password *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="New password *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="newPasswordField" promptText="At least 8 characters"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Confirm new password *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Button fx:id="changeButton" styleClass="primary" text="Change password"
                    onAction="#onChangePassword" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Label fx:id="messageLabel" styleClass="message" wrapText="true"/>
    </VBox>
</ScrollPane>
