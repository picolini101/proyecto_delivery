<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.MerchantOrdersController">

    <Label styleClass="page-title" text="My commerce orders"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox fx:id="ordersBox" spacing="10" style="-fx-padding: 12 0 12 0;"/>
    </ScrollPane>
</VBox>
