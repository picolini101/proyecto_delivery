<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="14" prefWidth="420" style="-fx-padding: 28; -fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.InputAddressController">
    <Label text="Ingrese la Dirección de Entrega" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
    <VBox spacing="6">
        <Label text="Ciudad" style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>
        <TextField fx:id="ciudadField" promptText="Ej. La Paz"/>
        <Label text="Avenida / Calle" style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>
        <TextField fx:id="avenidaField" promptText="Ej. Avenida Arce"/>
        <Label text="Número de casa" style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>
        <TextField fx:id="numeroCasaField" promptText="Ej. 123"/>
    </VBox>
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" onAction="#onCancel" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-background-radius: 7; -fx-padding: 9 18;"/>
        <Button fx:id="confirmButton" text="Confirmar" onAction="#onConfirm" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 18;"/>
    </HBox>
</VBox>
