<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.RemoveItemPanelController"
      spacing="16.0" prefWidth="480.0" prefHeight="550.0"
      style="-fx-background-color: #f8fafc; -fx-padding: 20;">

    <children>
        <!-- Encabezado del Panel -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label text="Gestión de Eliminación de Productos"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver a la Tienda" onAction="#onBackToShop"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button fx:id="refreshButton" text="Actualizar" onAction="#onRefresh"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </children>
        </HBox>

        <!-- Mensajes de feedback (Alerta / Confirmacion) -->
        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true"
               style="-fx-padding: 8 12 8 12; -fx-background-radius: 6; -fx-font-size: 13px;"/>

        <!-- Contenedor scrolleable de productos -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <content>
                <VBox fx:id="itemsContainer" spacing="10.0" style="-fx-padding: 10;">
                    <!-- Los items con sus botones Eliminar se agregan dinamicamente -->
                </VBox>
            </content>
        </ScrollPane>

        <!-- Mensaje de carrito vacio -->
        <Label fx:id="emptyCartLabel" text="El carrito no contiene productos para eliminar."
               visible="false" managed="false" alignment="CENTER"
               style="-fx-text-fill: #64748b; -fx-font-style: italic; -fx-padding: 20;"/>

        <!-- Resumen Financiero Recalculado -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <children>
                <HBox>
                    <children>
                        <Label text="Subtotal General:" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="subtotalValueLabel" text="Bs. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    </children>
                </HBox>
                <HBox>
                    <children>
                        <Label text="Costo de Envío:" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="shippingValueLabel" text="Bs. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    </children>
                </HBox>
                <Region style="-fx-background-color: #cbd5e1; -fx-pref-height: 1;"/>
                <HBox>
                    <children>
                        <Label text="Total Estimado:" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalValueLabel" text="Bs. 0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>