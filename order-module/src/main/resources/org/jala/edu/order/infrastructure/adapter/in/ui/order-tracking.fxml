<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.OrderTrackingController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" prefHeight="400.0" prefWidth="700.0" style="-fx-background-color: #fcf9f2; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <Label fx:id="shortIdLabel" style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="REF: XXXX" />

                <Label fx:id="productNameLabel" style="-fx-text-fill: #222222; -fx-font-weight: bold; -fx-padding: 5 0 10 0;" text="Nombre del Producto">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>

                <VBox prefHeight="40.0" />

                <!-- Contenedor del Stepper -->
                <HBox fx:id="stepperContainer" alignment="CENTER" spacing="10.0" />

                <VBox prefHeight="40.0" />

                <Label fx:id="statusMessageLabel" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 16px;" text="Estado actual..." wrapText="true" />

                <Button onAction="#onBack" mnemonicParsing="false" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" text="Volver" VBox.vgrow="ALWAYS" VBox.margin="$x0" />
            </children>
        </VBox>
    </children>
</AnchorPane>