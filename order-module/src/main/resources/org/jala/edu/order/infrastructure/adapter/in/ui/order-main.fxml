<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.OrderMainController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="Orders"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo carrito" onAction="#onNewCart"/>
    </HBox>

    <TableView VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No tienes pedidos todavía"/>
        </placeholder>
    </TableView>
</VBox>