<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.OrderMainController">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="page-title" text="Mis pedidos"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo carrito" onAction="#onNewCart"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: #f4f4f4;">
        <VBox fx:id="ordersContainer" spacing="15" style="-fx-padding: 20;">
        <Label fx:id="emptyLabel" text="No tienes pedidos registrados" style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
        </VBox>
    </ScrollPane>
</VBox>
