<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.order.infrastructure.adapter.in.ui.OrderMainController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="Orders"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Mis Pedidos" onAction="#onViewHistory" style="-fx-margin-right: 10;"/>
        <Button text="Nuevo carrito" onAction="#onNewCart"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox fx:id="cardsBox" spacing="10" style="-fx-padding: 12 0 12 0;"/>
    </ScrollPane>
</VBox>
