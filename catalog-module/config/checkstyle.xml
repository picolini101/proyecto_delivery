<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Reglas de análisis estático de catalog-module (Lab 8, Actividad 1). Son pocas a propósito:
    cada regla responde a un acuerdo del equipo (Clean Code, KISS, SOLID) y ninguna es de formato.
    Ejecutar: ./mvnw checkstyle:check -> target/checkstyle-result.xml
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^(package|import) "/>
    </module>
    <module name="SuppressWarningsFilter"/>
    <module name="TreeWalker">
        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <!-- Nombres -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <!-- Constantes en MAYÚSCULAS; "log" es el nombre habitual de un logger estático -->
        <module name="ConstantName">
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="PackageName"/>
        <!-- Bloques -->
        <module name="NeedBraces"/>
        <module name="EmptyBlock"/>
        <module name="EmptyCatchBlock"/>
        <!-- Errores comunes -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="ModifiedControlVariable"/>
        <!-- Tamaño: métodos pequeños (KISS) -->
        <module name="MethodLength">
            <property name="max" value="60"/>
        </module>
        <!-- Los constructores se omiten: una entidad se construye con todos sus campos -->
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <!-- Permite que un método omita una regla con @SuppressWarnings("checkstyle:<regla>") y un motivo -->
        <module name="SuppressWarningsHolder"/>
        <!-- Sin salida por consola: usar un logger -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Usa un logger en lugar de System.out/System.err."/>
        </module>
    </module>
</module>