<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Lista de productos para gestión: seleccionar una fila y pulsar Edit (o doble clic) abre el diálogo de edición -->
<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.catalog.infrastructure.adapter.in.ui.ManageProductsController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="Manage products"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="message"/>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="New availability:"/>
        <ComboBox fx:id="availabilitySelector"
                  promptText="Select availability"
                  prefWidth="160"/>
        <Button fx:id="updateAvailabilityButton"
                text="Update availability"
                onAction="#onUpdateAvailability"/>
    </HBox>

    <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No products yet. Register one from the Catalog main view."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="160"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
            <TableColumn fx:id="stockColumn" text="Stock" prefWidth="80"/>
            <TableColumn fx:id="availabilityColumn" text="Availability" prefWidth="120"/>
            <TableColumn fx:id="createdAtColumn" text="Created at" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>