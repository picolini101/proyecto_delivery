<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<!-- Catálogo de un comercio visto por el cliente: tarjetas con imagen, nombre, categoría y precio (solo lectura) -->
<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.catalog.infrastructure.adapter.in.ui.CustomerCatalogController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="Catalog"/>
        <ComboBox fx:id="commerceSelector" promptText="Select a commerce"/>
        <TextField fx:id="searchField" promptText="Search by name or category" prefColumnCount="20"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="message"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <ScrollPane fx:id="catalogScrollPane"
            styleClass="catalog-scroll"
            fitToWidth="true"
            VBox.vgrow="ALWAYS">
        <FlowPane fx:id="productsPane" styleClass="catalog-grid" hgap="16" vgap="16"/>
    </ScrollPane>

    <HBox fx:id="paginationControls" styleClass="pagination-controls"
          alignment="CENTER" spacing="16">
        <Button fx:id="previousPageButton"
                text="Previous"
                onAction="#onPreviousPage"/>
        <Label fx:id="pageLabel" text="Page 1 of 1"/>
        <Button fx:id="nextPageButton"
                text="Next"
                onAction="#onNextPage"/>
    </HBox>

</VBox>
